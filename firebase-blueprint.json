{
  "entities": {
    "ResortSettings": {
      "title": "ResortSettings",
      "description": "Basic resort configuration including resort name and standard check-in/out times.",
      "type": "object",
      "properties": {
        "resortName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display name of the resort."
        },
        "resortSubtitle": {
          "type": "string",
          "maxLength": 160,
          "description": "Optional subtitle or location note."
        },
        "checkInTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "Standard check-in time (e.g. 14:00)."
        },
        "checkOutTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "Standard check-out time (e.g. 12:00)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of staff who updated settings."
        },
        "updatedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name of staff who updated settings."
        }
      },
      "required": [
        "resortName",
        "resortSubtitle",
        "checkInTime",
        "checkOutTime",
        "updatedAt",
        "updatedByUid",
        "updatedByName"
      ]
    },
    "Room": {
      "title": "Room",
      "description": "Individual resort villa or room unit available for booking.",
      "type": "object",
      "properties": {
        "resortId": {
          "type": "string",
          "pattern": "^main$",
          "maxLength": 16,
          "description": "Resort workspace identifier."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Room name or number (e.g. Villa 01, Deluxe 101)."
        },
        "roomType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Room category label (e.g. Pool Villa, Deluxe Room)."
        },
        "capacity": {
          "type": "integer",
          "description": "Maximum guest capacity."
        },
        "sortOrder": {
          "type": "integer",
          "description": "Display ordering index."
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the room is currently active for sale."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "resortId",
        "name",
        "roomType",
        "capacity",
        "sortOrder",
        "isActive",
        "createdAt",
        "updatedAt",
        "updatedByUid"
      ]
    },
    "Booking": {
      "title": "Booking",
      "description": "Resort room reservation with multi-room support, meal options, guest info, and staff audit trail.",
      "type": "object",
      "properties": {
        "resortId": {
          "type": "string",
          "pattern": "^main$",
          "maxLength": 16
        },
        "checkIn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "checkOut": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "roomIds": {
          "type": "array",
          "description": "Booked room document IDs (1 to 20 rooms)."
        },
        "roomNames": {
          "type": "array",
          "description": "Snapshot of booked room names (1 to 20 rooms)."
        },
        "category": {
          "type": "string",
          "enum": ["room_only", "room_with_meal"],
          "maxLength": 32
        },
        "mealBreakfast": {
          "type": "string",
          "maxLength": 100
        },
        "mealDinner": {
          "type": "string",
          "maxLength": 100
        },
        "mealSetsCount": {
          "type": "integer"
        },
        "mealNotes": {
          "type": "string",
          "maxLength": 500
        },
        "guestName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "guestPhone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "bookingChannel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "specialRequest": {
          "type": "string",
          "maxLength": 1000
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["pending", "deposit", "paid"],
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "cancelled"],
          "maxLength": 20
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "cancelledByName": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "resortId",
        "checkIn",
        "checkOut",
        "roomIds",
        "roomNames",
        "category",
        "mealBreakfast",
        "mealDinner",
        "mealSetsCount",
        "mealNotes",
        "guestName",
        "guestPhone",
        "bookingChannel",
        "specialRequest",
        "paymentStatus",
        "status",
        "createdByUid",
        "createdByName",
        "createdAt",
        "updatedByUid",
        "updatedByName",
        "updatedAt",
        "cancelledByName"
      ]
    },
    "RoomLock": {
      "title": "RoomLock",
      "description": "Atomic per-room per-night lock preventing concurrent double bookings.",
      "type": "object",
      "properties": {
        "resortId": {
          "type": "string",
          "pattern": "^main$",
          "maxLength": 16
        },
        "roomId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "bookingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "resortId",
        "roomId",
        "date",
        "bookingId",
        "createdByUid",
        "createdAt"
      ]
    },
    "StaffProfile": {
      "title": "StaffProfile",
      "description": "Public staff member identity record (non-PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["admin", "staff"],
          "maxLength": 20
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "role",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "StaffPrivateInfo": {
      "title": "StaffPrivateInfo",
      "description": "Isolated PII record for staff email address.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "email",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/resortSettings/{settingId}": {
      "schema": {
        "$ref": "#/entities/ResortSettings"
      },
      "description": "Singleton resort configuration document (/resortSettings/main)."
    },
    "/rooms/{roomId}": {
      "schema": {
        "$ref": "#/entities/Room"
      },
      "description": "Resort rooms and villas inventory."
    },
    "/bookings/{bookingId}": {
      "schema": {
        "$ref": "#/entities/Booking"
      },
      "description": "Resort reservations with real-time availability status."
    },
    "/roomLocks/{lockId}": {
      "schema": {
        "$ref": "#/entities/RoomLock"
      },
      "description": "Atomic per-room per-night locks enforcing zero double bookings."
    },
    "/staff/{uid}": {
      "schema": {
        "$ref": "#/entities/StaffProfile"
      },
      "description": "Active staff member profiles (non-PII)."
    },
    "/staff/{uid}/private/{docId}": {
      "schema": {
        "$ref": "#/entities/StaffPrivateInfo"
      },
      "description": "Isolated private staff contact info."
    }
  }
}
